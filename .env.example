# scripts/export/ (F-004 エクスポートスクリプト) が読み込む設定。
# 実際の値は .env にコピーして設定する(.env はgit管理対象外)。
# シングルワールド限定運用のため、複数ワールドを切り替える仕組みは用意しない。

# JourneyMapのワールドセーブのローカルパス
# 例: C:\Users\<user>\AppData\Roaming\.minecraft\journeymap\data\sp\<ワールド名>
JOURNEYMAP_WORLD_DATA_PATH=

# scripts/deploy/ (F-005 デプロイスクリプト) が読み込む設定。
# アップロード先のCloudflare R2バケット名。
# Cloudflareの認証情報自体は `npx wrangler login` またはWrangler CLIの
# CLOUDFLARE_API_TOKEN環境変数で扱う(このファイル・.envには書かない)。
CLOUDFLARE_R2_BUCKET_NAME=
